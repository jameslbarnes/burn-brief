{
  "name": "burn-brief",
  "productName": "burn/brief",
  "version": "0.1.4",
  "description": "A private, local-first briefing and action queue for your Burning Man WhatsApp groups",
  "type": "module",
  "bin": {
    "burn-brief": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "start": "npm run build && electron .",
    "demo:data": "npm run build && node scripts/create-demo.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "release:check": "npm run check && npm test && npm run build && node --check electron/main.js && node --check electron/preload.cjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "release:mac": "npm run dist:mac && xcrun notarytool submit release/*.dmg --keychain-profile burn-brief --wait && xcrun stapler staple release/*.dmg"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameslbarnes/burn-brief.git"
  },
  "homepage": "https://github.com/jameslbarnes/burn-brief#readme",
  "bugs": {
    "url": "https://github.com/jameslbarnes/burn-brief/issues"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "main": "electron/main.js",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
